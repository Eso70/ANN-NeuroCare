# Application
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173

# PostgreSQL: existing local service; postgres account selected for this workspace
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=neurocare_db
DB_USER=postgres
# Use the literal password, without URL encoding. Single quotes protect # and spaces.
DB_PASSWORD='replace-with-your-postgres-password'

# Model
# Trusted trained model directory, relative to the project root (absolute paths also work).
# Blank disables inference. Use forward slashes for portable paths.
MODEL_DIR=artifacts/20261029T043159Z-bd9e866c

# Optional deployment override: DATABASE_URL takes precedence over DB_* when set.
# Normally leave DATABASE_URL unset and edit the fields above.
